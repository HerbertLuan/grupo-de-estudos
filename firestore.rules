rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funções auxiliares de autorização
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }


    // Nicknames: leitura pública/autenticada para validação de unicidade; escrita somente via backend
    match /nicknames/{nickname} {
      allow read: if isAuthenticated();
      allow write: if false; // Gerenciado por Cloud Functions
    }

    // Usuários
    match /users/{uid} {
      // Qualquer usuário autenticado pode ler perfis para visualização em grupo e ranking
      allow read: if isAuthenticated();
      
      // Criação inicial é feita pelo Cloud Function (registerUser)
      allow create: if false;

      // O usuário pode atualizar apenas campos cosméticos do próprio perfil
      allow update: if isOwner(uid) && 
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'avatarUrl', 'updatedAt']);

      allow delete: if false;

      // Subcoleção de Sessões de Estudo
      match /studySessions/{sessionId} {
        // Apenas o próprio usuário pode ler suas sessões
        allow read: if isOwner(uid);
        // Escrita exclusivamente por Cloud Functions para garantir regras de negócio
        allow write: if false;
      }

      // Subcoleção de Registro Diário
      match /dailyStudy/{dateId} {
        // Membros autenticados podem ler para histórico/perfil público
        allow read: if isAuthenticated();
        // Escrita estritamente bloqueada no cliente (somente Cloud Functions)
        allow write: if false;
      }

      // Subcoleção de Badges Conquistadas
      match /badges/{badgeId} {
        allow read: if isAuthenticated();
        // Concedidas exclusivamente por Cloud Functions
        allow write: if false;
      }
    }

    // Grupos
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow write: if false; // Criado e gerenciado por Cloud Functions

      match /members/{memberUid} {
        allow read: if isAuthenticated();
        allow write: if false; // Agregados e rankings atualizados exclusivamente por Cloud Functions
      }
    }

    // Temporadas
    match /seasons/{seasonId} {
      allow read: if isAuthenticated() && exists(/databases/$(database)/documents/groups/$(resource.data.groupId)/members/$(request.auth.uid));
      allow write: if false;
    }

    // Catálogo de Níveis
    match /levels/{levelId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Catálogo de Badges
    match /badges/{badgeId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Feed do Grupo
    match /feed/{postId} {
      allow read: if isAuthenticated();
      // Publicações oficiais de conquistas são criadas exclusivamente por Cloud Functions
      allow write: if false;

      // Curtidas no Post: usuário só pode manipular o documento com o seu próprio UID
      match /likes/{likeUid} {
        allow read: if isAuthenticated();
        allow write: if isOwner(likeUid);
      }

      // Comentários: usuário pode criar com seu próprio UID e deletar o próprio comentário
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && 
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 500;
        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
        allow update: if false; // Não permite edição de comentários inicialmente
      }
    }
  }
}
